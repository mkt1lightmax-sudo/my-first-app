# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env เข้า git)

# Connection string จาก Neon (Postgres) — เอาจาก neon.tech หลังสร้างโปรเจกต์
DATABASE_URL=

# ใช้เซ็นและตรวจสอบ JWT (โทเค็นล็อกอิน) — สุ่มด้วยคำสั่ง: openssl rand -base64 32
JWT_SECRET=

# บัญชี LINE OA / เพจ / IG เพิ่มในแอปได้เลย (เมนู "บัญชีแชท") — ไม่ต้องใส่ที่นี่

# Meta App (Messenger + Instagram) — developers.facebook.com > แอปของคุณ > App settings > Basic > App secret
META_APP_SECRET=
# รหัสอะไรก็ได้ที่ตั้งเอง ใช้ตอนตั้งค่า Webhook ในหน้า Meta App (ใส่ค่าเดียวกันทั้งสองที่)
META_VERIFY_TOKEN=
